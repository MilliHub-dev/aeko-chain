# .env.production
# Production build-time configuration for the AEKO web UI (testnet).
# All traffic goes directly to the public subdomains fronted by Coolify's
# Traefik proxy — no relative /api proxying, no port numbers.

# JSON-RPC (HTTP) and pubsub (WebSocket).
VITE_AEKO_TESTNET_RPC=https://rpc.aeko.online
VITE_AEKO_TESTNET_WS=wss://ws.aeko.online

# Explorer indexer REST API and explorer web UI.
# scan.aeko.online is not yet registered, so the UI lives at gossip.aeko.online
# for now. When scan.aeko.online comes up, flip VITE_AEKO_TESTNET_EXPLORER to it.
VITE_AEKO_TESTNET_EXPLORER_API=https://api.aeko.online
VITE_AEKO_TESTNET_EXPLORER=https://gossip.aeko.online

# Mainnet is not live yet — leave the explorer API empty so the UI hides it.
VITE_AEKO_MAINNET_EXPLORER_API=

# The faucet is a TCP service reached indirectly via the validator's
# requestAirdrop RPC, so we don't expose a separate URL here.
