# .env.production
# This file provides the necessary production variables for the AEKO web UI when built inside the Docker image for AWS testnets.

# The frontend communicates with the backend via the /api endpoint (proxied by nginx inside the docker container)
VITE_AEKO_TESTNET_EXPLORER_API=/api
VITE_AEKO_MAINNET_EXPLORER_API=/api

# Note: VITE_AEKO_TESTNET_FAUCET_URL, VITE_AEKO_TESTNET_RPC, and VITE_AEKO_TESTNET_EXPLORER
# are now dynamically inferred from the browser's hostname (e.g. your AWS public IP).
# No need to hardcode them here anymore!
