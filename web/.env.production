# .env.production
# This file provides the necessary production variables for the AEKO web UI when built inside the Docker image for AWS testnets.

# The frontend communicates with the backend via the /api endpoint (proxied by nginx inside the docker container)
VITE_AEKO_TESTNET_EXPLORER_API=/api
VITE_AEKO_MAINNET_EXPLORER_API=/api

# Faucet settings - The UI will connect to the faucet on port 9900 of this instance
# Ensure port 9900 is open in your AWS security group!
VITE_AEKO_TESTNET_FAUCET_URL=http://your-aws-public-ip-here:9900

# To test this locally or on AWS with standard RPC defaults:
VITE_AEKO_TESTNET_RPC=https://api.testnet.aeko.chain
VITE_AEKO_TESTNET_WS=wss://api.testnet.aeko.chain
VITE_AEKO_TESTNET_EXPLORER=https://testnet.explorer.aeko.chain
