AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=latest

# The active/default network. Today this example is the deployed testnet.
AEKO_NETWORK=testnet
AEKO_RPC_URL=https://rpc.aeko.online
AEKO_WS_URL=wss://ws.aeko.online
AEKO_EXPLORER_API_URL=https://api.aeko.online

# Public alternate deployments shown by the Scan toggle. Configure complete
# triplets only for Mainnet/Testnet deployments that actually exist.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_TESTNET_RPC_URL=
AEKO_TESTNET_WS_URL=
AEKO_TESTNET_EXPLORER_API_URL=

# Optional NTF example metadata. This is feature data, not a network.
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
AEKO_LOG_FORMAT=json
AEKO_LOG_LEVEL=info
AEKO_EXPLORER_PROXY_TIMEOUT_MS=20000
