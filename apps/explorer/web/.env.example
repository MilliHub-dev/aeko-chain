# Aeko Scan local-development environment.
# Scan is the one multi-network application. Generic URLs describe the
# active/default network; prefixed triplets describe optional remote networks.

AEKO_NETWORK=localnet
AEKO_RPC_URL=http://127.0.0.1:8899
AEKO_WS_URL=ws://127.0.0.1:8900
AEKO_EXPLORER_API_URL=http://127.0.0.1:8088

AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_TESTNET_RPC_URL=
AEKO_TESTNET_WS_URL=
AEKO_TESTNET_EXPLORER_API_URL=
AEKO_DEVNET_RPC_URL=
AEKO_DEVNET_WS_URL=
AEKO_DEVNET_EXPLORER_API_URL=
AEKO_LOCALNET_RPC_URL=
AEKO_LOCALNET_WS_URL=
AEKO_LOCALNET_EXPLORER_API_URL=

AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
