# AEKO Explorer Web environment reference.
#
# One source of truth:
# - deployed/preview containers use AEKO_* runtime variables
# - local Vite development uses only the optional loopback VITE_AEKO_LOCAL_* trio
#
# docker/explorer-ui-entrypoint.sh writes the runtime AEKO_* values to
# /runtime-config.js when the container starts. Remote testnet/mainnet/demo
# values are never duplicated as VITE_* variables.

# Required deployed testnet/runtime endpoints.
AEKO_PUBLIC_RPC_URL=
AEKO_PUBLIC_WS_URL=
AEKO_PUBLIC_EXPLORER_API_URL=
AEKO_PUBLIC_EXPLORER_URL=
AEKO_PUBLIC_FUNDING_URL=

# Optional mainnet endpoints. Leave all four empty until mainnet is available.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_MAINNET_EXPLORER_URL=

# Optional canonical AEKO-721 demo identifiers.
# AEKO_DEMO_RPC_URL may be omitted to reuse AEKO_PUBLIC_RPC_URL.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=

# Optional local Vite overrides.
# If omitted, local Vite development already defaults to these loopback ports.
# If any one is set, all three must be set and must remain loopback endpoints.
VITE_AEKO_LOCAL_RPC=http://127.0.0.1:8899
VITE_AEKO_LOCAL_WS=ws://127.0.0.1:8900
VITE_AEKO_LOCAL_EXPLORER_API=http://127.0.0.1:8088
