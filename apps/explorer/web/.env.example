# AEKO Explorer Web local-development endpoint reference.
#
# Copy this file to .env.local when running `npm run dev`.
#
# There is ONE testnet endpoint family: AEKO_PUBLIC_*.
# - Keep the loopback values below to run the local UI against a local validator.
# - To test the same local UI against the online/public testnet, replace these
#   same AEKO_PUBLIC_* values with the deployed testnet RPC, WebSocket,
#   Explorer API, Explorer UI and Funding endpoints.
#
# Do not add VITE_AEKO_* endpoint variables. Local Vite and deployed containers
# intentionally consume the same AEKO_PUBLIC_*/AEKO_MAINNET_* contract.
#
# Production images do NOT bake these values. Coolify/Dokploy use
# docker/env.public.example, and docker/explorer-ui-entrypoint.sh injects the
# deployed runtime configuration when the container starts.

# Testnet/public endpoints.
# The four core endpoints must be configured together. Funding may be blank
# when the selected test network does not expose the public Funding Gateway.
AEKO_PUBLIC_RPC_URL=http://127.0.0.1:8899
AEKO_PUBLIC_WS_URL=ws://127.0.0.1:8900
AEKO_PUBLIC_EXPLORER_API_URL=http://127.0.0.1:8088
AEKO_PUBLIC_EXPLORER_URL=http://127.0.0.1:4000
AEKO_PUBLIC_FUNDING_URL=

# Mainnet (leave all four empty until a mainnet deployment is available).
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_MAINNET_EXPLORER_URL=

# Optional AEKO-721 demo identifiers.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
