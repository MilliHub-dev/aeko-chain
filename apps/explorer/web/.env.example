# AEKO Explorer Web local-development endpoint reference.
#
# Copy this file to .env.local when running `npm run dev`. These values may
# point to localhost, a remote testnet, or a remote mainnet. Vite reads only
# the whitelisted AEKO_TESTNET_*, AEKO_MAINNET_* and AEKO_DEMO_* keys below.
#
# Production images do NOT bake these values. Coolify/Dokploy continue to use
# docker/env.public.example, and docker/explorer-ui-entrypoint.sh injects the
# deployed runtime configuration when the container starts.

# Testnet (all four core endpoints must be set together).
AEKO_TESTNET_RPC_URL=http://127.0.0.1:8899
AEKO_TESTNET_WS_URL=ws://127.0.0.1:8900
AEKO_TESTNET_EXPLORER_API_URL=http://127.0.0.1:8088
AEKO_TESTNET_EXPLORER_URL=http://127.0.0.1:4000
AEKO_TESTNET_FUNDING_URL=


# Optional AEKO-721 demo identifiers.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
