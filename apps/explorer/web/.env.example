# AEKO Explorer Web environment template.
# Copy to `.env.local` for local work; production containers use the same
# names through docker/env.public.example.
#
# Deploy rule (single source of truth):
# - AEKO_ENV=local exposes ONLY localnet (loopback validator).
# - AEKO_ENV=testnet exposes ONLY testnet (loopback fallback in Vite dev
#   when no testnet endpoints are set).
# - AEKO_ENV=production exposes testnet + mainnet. Production surfaces
#   default to mainnet whenever AEKO_MAINNET_* is fully configured; an
#   unconfigured mainnet renders as "coming soon". The Test Console /
#   network console, nft-demo, Social E2E lab and developer
#   testing/simulation flows stay pinned to testnet.
# - Explicit env values always override hardcoded loopback defaults.
#
# Never set NODE_ENV in a dotenv file: Vite warns for any dotenv NODE_ENV
# except development, and the deploy env travels via AEKO_ENV instead.
# (`vite` serve defaults to a local deploy; `vite build` is neutral and the
# production container entrypoint injects the real deploy env at startup.)
#
# The browser receives only public RPC/WebSocket/Funding endpoints. Indexed
# Explorer reads use same-origin /api/explorer/{network}; Vite and the
# production Explorer UI server proxy those paths to server-only upstreams.
# Do not add a second Vite-specific endpoint prefix.

# Deploy environment: local | testnet | production.
AEKO_ENV=local

# Testnet browser endpoints (testnet and production deploys; ignored in local).
AEKO_TESTNET_RPC_URL=https://rpc.aeko.online
AEKO_TESTNET_WS_URL=wss://ws.aeko.online
AEKO_PUBLIC_FUNDING_URL=

# Server-only Explorer upstream for /api/explorer/testnet. Production Compose
# defaults this to http://explorer-api:8088. There is deliberately NO public
# explorer-backend host — the backend stays private, so local dev needs a
# local backend (cargo run -p aeko-explorer-backend --example api_server,
# plus PostgreSQL) or explorer reads fail. The dev proxy falls back to the
# loopback default below.
AEKO_TESTNET_EXPLORER_API_URL=https://api.aeko.online

# Optional mainnet browser endpoints (production deploys only; ignored in
# local and testnet deploys). Set all three together. When fully set,
# production surfaces default to mainnet and Admin always uses mainnet.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=

# Optional localnet overrides for local development. Any value opts into the
# localnet network; unset pieces fall back to loopback (127.0.0.1:8899 /
# ws://127.0.0.1:8900 / http://127.0.0.1:8088). Explicit values here always
# win over the hardcoded loopback defaults.
AEKO_LOCALNET_RPC_URL=
AEKO_LOCALNET_WS_URL=
AEKO_LOCALNET_FUNDING_URL=
AEKO_LOCALNET_EXPLORER_API_URL=

# Optional canonical AEKO-721 demo values.
# Leave AEKO_DEMO_RPC_URL empty to reuse the selected network RPC.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
