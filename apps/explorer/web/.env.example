# Aeko Scan development environment.
#
# Production Scan exposes Mainnet and Testnet only. Local Vite development may
# omit these values and will use the built-in loopback localnet fallback.
AEKO_NETWORK=testnet
AEKO_RPC_URL=https://rpc.aeko.online
AEKO_WS_URL=wss://ws.aeko.online
# Browser Explorer/funding requests use this public API origin directly.
AEKO_EXPLORER_API_URL=https://api.aeko.online
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_TESTNET_RPC_URL=
AEKO_TESTNET_WS_URL=
AEKO_TESTNET_EXPLORER_API_URL=
