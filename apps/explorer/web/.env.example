# AEKO Explorer Web environment reference.
#
# Production containers do not bake public deployment URLs into the Vite
# bundle. docker/explorer-ui-entrypoint.sh reads AEKO_* runtime variables and
# writes /runtime-config.js when the container starts. The non-VITE variables
# below document that production contract; Vite itself will not expose them.

# Required production/container runtime endpoints.
AEKO_PUBLIC_RPC_URL=
AEKO_PUBLIC_WS_URL=
AEKO_PUBLIC_EXPLORER_API_URL=
AEKO_PUBLIC_EXPLORER_URL=
AEKO_PUBLIC_FUNDING_URL=

# Optional mainnet runtime endpoints.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_MAINNET_EXPLORER_URL=

# Optional AEKO-721 runtime demo identifiers.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=

# Local Vite development / CI preview only.
# These three overrides are atomic and must remain loopback endpoints.
VITE_AEKO_LOCAL_RPC=http://127.0.0.1:8899
VITE_AEKO_LOCAL_WS=ws://127.0.0.1:8900
VITE_AEKO_LOCAL_EXPLORER_API=http://127.0.0.1:8088

# Remote endpoints are blocked during vite dev unless this is explicitly true.
VITE_AEKO_ALLOW_REMOTE_IN_DEV=false

# Optional explicit remote Vite preview values. Leave empty for normal
# production images because runtime-config.js owns production endpoints.
VITE_AEKO_TESTNET_RPC=
VITE_AEKO_TESTNET_WS=
VITE_AEKO_TESTNET_EXPLORER_API=
VITE_AEKO_TESTNET_EXPLORER=
VITE_AEKO_TESTNET_FUNDING_URL=

VITE_AEKO_MAINNET_RPC=
VITE_AEKO_MAINNET_WS=
VITE_AEKO_MAINNET_EXPLORER_API=
VITE_AEKO_MAINNET_EXPLORER=

# Optional Vite-only AEKO-721 preview identifiers.
VITE_AEKO_DEMO_RPC=
VITE_AEKO_DEMO_COLLECTION=
VITE_AEKO_DEMO_TOKEN=
VITE_AEKO_DEMO_METADATA_URI=
VITE_AEKO_DEMO_COLLECTION_SEED=aeko-genesis-collection
VITE_AEKO_DEMO_TOKEN_SEED=aeko-genesis-token-1
