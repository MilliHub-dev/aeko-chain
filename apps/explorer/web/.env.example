# AEKO Explorer Web local-development overrides.
#
# Remote/deployed configuration does not belong in this file.
# Use docker/env.public.example for all AEKO_* runtime values. Containers write
# those values to /runtime-config.js at startup.
#
# These overrides are optional because local Vite development already defaults
# to the same loopback ports. If any one is changed, set all three together and
# keep them on loopback addresses.
VITE_AEKO_LOCAL_RPC=http://127.0.0.1:8899
VITE_AEKO_LOCAL_WS=ws://127.0.0.1:8900
VITE_AEKO_LOCAL_EXPLORER_API=http://127.0.0.1:8088
