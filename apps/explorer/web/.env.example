# AEKO Scan local-development environment template.
# Endpoint names identify blockchain network + service, not same-host/public
# topology. Copy to .env.local for local Vite development.

AEKO_ENV=local

# Localnet is active in the default local development mode.
AEKO_LOCALNET_RPC_URL=http://127.0.0.1:8899
AEKO_LOCALNET_WS_URL=ws://127.0.0.1:8900
AEKO_LOCALNET_EXPLORER_API_URL=http://127.0.0.1:8088

# Optional testnet. Populate all three together when intentionally running the
# Vite dev UI in AEKO_ENV=testnet mode.
AEKO_TESTNET_RPC_URL=
AEKO_TESTNET_WS_URL=
AEKO_TESTNET_EXPLORER_API_URL=

# Optional mainnet. Populate all three together when mainnet is live.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=

# Optional canonical AEKO-721 demo values.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
