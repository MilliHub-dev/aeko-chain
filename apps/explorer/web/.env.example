# AEKO Scan environment template.
# Endpoint names identify blockchain network + service. Whether a service is on
# the same machine, another Coolify instance, or another provider is a deployment
# detail and is not encoded as "public" or "internal" in the variable name.

# UI deployment mode controls which configured networks are shown:
# local -> localnet only; testnet -> testnet only; production -> testnet +
# optional mainnet. This is a UI deployment mode, not a blockchain network name.
AEKO_ENV=local

# Testnet. Production defaults use the canonical AEKO domains.
AEKO_TESTNET_RPC_URL=https://rpc.aeko.online
AEKO_TESTNET_WS_URL=wss://ws.aeko.online
AEKO_TESTNET_EXPLORER_API_URL=https://api.aeko.online

# Mainnet remains unavailable until all three endpoints are configured.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=

# Local-development overrides.
AEKO_LOCALNET_RPC_URL=http://127.0.0.1:8899
AEKO_LOCALNET_WS_URL=ws://127.0.0.1:8900
AEKO_LOCALNET_EXPLORER_API_URL=http://127.0.0.1:8088

# Optional canonical AEKO-721 demo values.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
