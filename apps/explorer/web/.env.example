# AEKO Explorer Web local-development environment.
#
# Network policy (single source of truth):
# - mainnet is production. Every production surface defaults to mainnet
#   whenever AEKO_MAINNET_* is fully configured.
# - testnet is the shared test server. The Test Console / network console,
#   nft-demo, Social E2E lab and developer testing/simulation flows stay
#   pinned to testnet and never silently follow mainnet.
# - localnet means "running locally" (loopback validator). Explicit
#   AEKO_LOCALNET_* env values always override the hardcoded 127.0.0.1
#   loopback defaults below. Env variables are prioritized above hardcoded
#   network config.
#
# The browser receives only public RPC/WebSocket/Funding endpoints. Indexed
# Explorer reads use same-origin /api/explorer/{network}; Vite and the production
# Explorer UI server proxy those paths to server-only upstreams.
#
# Production containers use the same names through docker/env.public.example.
# Do not add a second Vite-specific endpoint prefix.

# Testnet browser endpoints.
AEKO_PUBLIC_RPC_URL=
AEKO_PUBLIC_WS_URL=
AEKO_PUBLIC_FUNDING_URL=

# Server-only Explorer upstream used by the Vite dev proxy. Production Compose
# defaults this to http://explorer-api:8088. In local `vite dev` with nothing
# else configured, the dev proxy falls back to http://127.0.0.1:8088.
AEKO_INTERNAL_EXPLORER_API_URL=http://127.0.0.1:8088

# Optional mainnet browser endpoints. Set both together with the internal
# mainnet Explorer upstream. When fully set, production surfaces default to
# mainnet and Admin always uses mainnet.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_INTERNAL_MAINNET_EXPLORER_API_URL=

# Optional localnet overrides for local development. Any value opts into the
# localnet network; unset pieces fall back to loopback (127.0.0.1:8899 /
# ws://127.0.0.1:8900 / http://127.0.0.1:8088). Explicit values here always
# win over the hardcoded loopback defaults.
AEKO_LOCALNET_RPC_URL=
AEKO_LOCALNET_WS_URL=
AEKO_LOCALNET_FUNDING_URL=
AEKO_INTERNAL_LOCALNET_EXPLORER_API_URL=

# Optional canonical AEKO-721 demo values.
# Leave AEKO_DEMO_RPC_URL empty to reuse the selected network RPC.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=
