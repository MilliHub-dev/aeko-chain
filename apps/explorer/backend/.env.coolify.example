AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=latest

# This Explorer API instance indexes exactly one chain environment.
AEKO_NETWORK=testnet
# These are server-to-server origins. Keep them private or DNS-only so funding
# settlement and indexing never depend on Cloudflare/WAF traversal.
AEKO_INTERNAL_RPC_URL=https://<private-or-dns-only-validator-rpc-origin>
AEKO_INTERNAL_WS_URL=wss://<private-or-dns-only-validator-ws-origin>
AEKO_INTERNAL_REGISTRY_URL=https://<private-or-dns-only-registry-origin>

EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres.example:5432/aeko_explorer
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=<long-random-settings-admin-token>
AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10
AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2
AEKO_REGISTRY_REFRESH_SECONDS=30
AEKO_REGISTRY_FETCH_TIMEOUT_SECONDS=10
AEKO_RESET_LEDGER=0
# Required for approval-gated requestGrant when the Validator configures the
# matching credential. requestAirdrop remains the instant developer path.
AEKO_FUNDING_AUTHORIZATION_KEY=<32-plus-character-server-secret>
AEKO_FUNDING_REQUESTS_PER_10_MIN=5
AEKO_FUNDING_RECONCILE_INTERVAL_SECS=5
# Mirror the Faucet daemon's hard ceiling. Policy-level console/manual caps may
# be lower, never higher.
AEKO_FAUCET_PER_REQUEST_CAP=100

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
AEKO_EXPLORER_LOG_FORMAT=json
AEKO_EXPLORER_LOG_FILTER=info,tower_http=info,hyper=warn,reqwest=warn,sqlx=warn
