# AEKO Explorer backend production configuration.
# Copy values into your deployment secret/environment manager. Do not commit
# credentials.

AEKO_EXPLORER_NETWORK=testnet

# Network-scoped chain endpoints. The current canonical public network is testnet.
AEKO_TESTNET_RPC_URL=https://rpc.aeko.online
AEKO_TESTNET_WS_URL=wss://ws.aeko.online
# No canonical public mainnet is declared yet. Configure these only when one exists.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
# Local development only.
AEKO_LOCALNET_RPC_URL=http://127.0.0.1:8899
AEKO_LOCALNET_WS_URL=ws://127.0.0.1:8900

AEKO_EXPLORER_BIND=0.0.0.0:8088

# Destructive new-chain signal shared with validator/bootstrap lifecycle.
AEKO_RESET_LEDGER=0

# Private control-plane credential used only by Operations Web when mutating
# durable Explorer settings. Use a random value of at least 32 characters.
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token

# Used only when PostgreSQL has no durable core indexer cursor yet.
AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128

# PostgreSQL is mandatory in production.
DATABASE_URL=postgres://aeko:change-me@postgres:5432/aeko_explorer
# AEKO_EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres:5432/aeko_explorer
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10

AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2

# Canonical bootstrap registry discovery.
# Testnet split deployments read these two generated files over HTTPS from the
# bootstrap resource. They contain public program/state/account addresses, not
# private keypair JSON.
AEKO_TESTNET_SOCIAL_REGISTRY_URL=https://bootstrap.aeko.online/social-registry.env
AEKO_TESTNET_PROTOCOL_REGISTRY_URL=https://bootstrap.aeko.online/protocol-registry.env

# Future mainnet. Leave unset until a mainnet is actually provisioned.
AEKO_MAINNET_SOCIAL_REGISTRY_URL=
AEKO_MAINNET_PROTOCOL_REGISTRY_URL=

# Local/Dokploy fallback. When a network-scoped registry URL is set, the URL is
# authoritative and these local files are not mixed into that registry.
AEKO_SOCIAL_REGISTRY_FILE=/state/social-registry.env
AEKO_PROTOCOL_REGISTRY_FILE=/protocol-state/protocol-registry.env
AEKO_REGISTRY_FETCH_TIMEOUT_SECS=5
AEKO_REGISTRY_CACHE_TTL_SECS=30

# Recovery-only explicit Social registry overrides. Normal deployments should
# use the generated registry source above so values stay genesis-consistent.
AEKO_SOCIAL_POSTS_STATE=
AEKO_SOCIAL_REWARDS_STATE=
AEKO_SOCIAL_STAKING_STATE=
AEKO_SOCIAL_ANTI_SPAM_STATE=
AEKO_SOCIAL_MONETIZATION_STATE=
AEKO_REWARDS_TREASURY_ACCOUNT=
AEKO_REWARD_VAULT_ACCOUNT=
AEKO_STAKE_VAULT_ACCOUNT=
AEKO_STAKE_REWARD_VAULT_ACCOUNT=
AEKO_TREASURY_ADDRESS=
AEKO_PLATFORM_FEE_BPS=
