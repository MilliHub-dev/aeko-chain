# AEKO Explorer backend production configuration.
# Copy values into your deployment secret/environment manager. Do not commit
# real credentials.

# Authoritative testnet chain endpoints.
AEKO_EXPLORER_RPC=https://rpc.aeko.online
AEKO_EXPLORER_WS=wss://ws.aeko.online
AEKO_EXPLORER_NETWORK=testnet
AEKO_EXPLORER_BIND=0.0.0.0:8088

# Destructive new-chain signal shared with the validator and bootstrap services.
# Keep this at 0 for normal redeploys. When set to 1, Explorer drops stale
# chain-derived PostgreSQL projections before binding to the live genesis.
AEKO_RESET_LEDGER=0

# Private control-plane credential used only by Operations Web when mutating
# durable application settings. Use a random value of at least 32 characters.
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token

# Used only when PostgreSQL has no durable `core` indexer cursor yet.
AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128

# PostgreSQL is mandatory in production. Either name is accepted; the explicit
# AEKO-prefixed variable takes precedence when both are present.
DATABASE_URL=postgres://aeko:change-me@postgres:5432/aeko_explorer
# AEKO_EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres:5432/aeko_explorer
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10

AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2

# Registries generated by the mandatory idempotent bootstrap services.
# Production/split deployments read the public registry documents over HTTPS.
# Local/legacy deployments may leave the URLs empty and use the file fallbacks.
# Schema v2 embeds AEKO_CHAIN_GENESIS_HASH so Explorer detects cross-genesis data.
AEKO_SOCIAL_REGISTRY_URL=https://registry.aeko.online/testnet/social.env
AEKO_PROTOCOL_REGISTRY_URL=https://registry.aeko.online/testnet/protocol.env
AEKO_SOCIAL_REGISTRY_FILE=
AEKO_PROTOCOL_REGISTRY_FILE=
# Recovery-only explicit state/vault overrides. Leave these empty during normal
# deployments so stale process environment cannot shadow the registry source.
AEKO_SOCIAL_POSTS_STATE=
AEKO_SOCIAL_REWARDS_STATE=
AEKO_SOCIAL_STAKING_STATE=
AEKO_SOCIAL_ANTI_SPAM_STATE=
AEKO_SOCIAL_MONETIZATION_STATE=
AEKO_REWARDS_TREASURY_ACCOUNT=
AEKO_REWARD_VAULT_ACCOUNT=
AEKO_STAKE_VAULT_ACCOUNT=
AEKO_STAKE_REWARD_VAULT_ACCOUNT=
AEKO_TREASURY_ADDRESS=
AEKO_PLATFORM_FEE_BPS=
