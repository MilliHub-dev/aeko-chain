# Chain endpoints (server-side only; never exposed to the browser).
AEKO_RPC_URL=http://localhost:8899
AEKO_EXPLORER_URL=http://localhost:8088
# Public explorer used for links on the faucet page.
PUBLIC_EXPLORER_URL=https://scan.aeko.online

# Operator sign-in. Both are required in production; in development the
# password falls back to "admin".
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters

# Shared secret the Aeko backend sends as `x-faucet-key` so its requests skip
# the per-IP throttle (it fronts many users from one address).
FAUCET_API_KEY=

# Where the faucet policy and grant ledger are persisted (mount a volume).
FAUCET_STATE_DIR=./data
# Initial public policy; editable at /airdrops afterwards.
FAUCET_DEFAULT_AMOUNT_AEKO=5
FAUCET_DEFAULT_COOLDOWN_HOURS=24
FAUCET_DEFAULT_DAILY_BUDGET_AEKO=5000
FAUCET_MAX_MANUAL_GRANT_AEKO=100
FAUCET_IP_REQUESTS_PER_10_MIN=5
