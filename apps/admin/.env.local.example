# Direct local development defaults to the Admin role.
AEKO_OPERATIONS_ROLE=admin

# Admin server-only dependencies.
AEKO_RPC_URL=http://localhost:8899
AEKO_INTERNAL_EXPLORER_API_URL=http://localhost:8088
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token
AEKO_INTERNAL_FUNDING_URL=http://localhost:3002
FUNDING_ADMIN_API_KEY=change-me-to-a-long-random-funding-admin-key

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters

# Funding Gateway variables belong on the separate funding service instance.
# When running that role directly, override AEKO_OPERATIONS_ROLE=funding and
# use a different port/process. Compose local publishes it on localhost:3002.
AEKO_PUBLIC_FUNDING_URL=http://localhost:3002
FUNDING_GATEWAY_KEY=
FUNDING_ALLOWED_ORIGINS=http://localhost:4000
FUNDING_STATE_DIR=./data
FUNDING_DEFAULT_AMOUNT_AEKO=5
FUNDING_DEFAULT_COOLDOWN_HOURS=24
FUNDING_DEFAULT_DAILY_BUDGET_AEKO=5000
FUNDING_MAX_MANUAL_GRANT_AEKO=100
FUNDING_MAX_CONSOLE_AIRDROP_AEKO=25
FUNDING_IP_REQUESTS_PER_10_MIN=5
