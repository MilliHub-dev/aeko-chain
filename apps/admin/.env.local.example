# Chain endpoints (server-side only; never exposed to the browser).
AEKO_RPC_URL=http://localhost:8899
AEKO_EXPLORER_URL=http://localhost:8088
PUBLIC_EXPLORER_URL=https://scan.aeko.online

# Public web roles. The Funding Portal and Admin Console are distinct web
# surfaces. The private Faucet Daemon has no public hostname.
FUNDING_PUBLIC_HOST=fund.aeko.online
ADMIN_PUBLIC_HOST=admin.aeko.online

# Operator sign-in.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters

# Server-to-server authorization used only when the validator protects its
# low-level requestAirdrop RPC. Leave empty for an unprotected local validator.
FUNDING_GATEWAY_KEY=

# Optional trusted application-backend key. A caller that sends this value as
# x-funding-key skips only the HTTP per-IP throttle; wallet cooldown and budget
# still apply.
FUNDING_CLIENT_API_KEY=

# Comma-separated browser origins allowed to call the public Funding API.
# Trusted server-to-server callers do not need CORS.
FUNDING_ALLOWED_ORIGINS=https://scan.aeko.online

# Persistent Funding Gateway policy/grant state.
FUNDING_STATE_DIR=./data
FUNDING_DEFAULT_AMOUNT_AEKO=5
FUNDING_DEFAULT_COOLDOWN_HOURS=24
FUNDING_DEFAULT_DAILY_BUDGET_AEKO=5000
FUNDING_MAX_MANUAL_GRANT_AEKO=100
FUNDING_IP_REQUESTS_PER_10_MIN=5
