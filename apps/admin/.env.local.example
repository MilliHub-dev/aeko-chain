# Internal dependencies. Compose deployments use same-network service names.
AEKO_RPC_URL=http://validator:8899
AEKO_EXPLORER_URL=http://explorer-api:8088
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token

# Public ingress URLs. Operations Web serves both funding and admin surfaces.
AEKO_PUBLIC_RPC_URL=http://localhost:8899
AEKO_PUBLIC_WS_URL=ws://localhost:8900
AEKO_PUBLIC_EXPLORER_API_URL=http://localhost:8088
AEKO_PUBLIC_EXPLORER_URL=http://localhost:4000
AEKO_PUBLIC_FUNDING_URL=http://localhost:3001
AEKO_PUBLIC_ADMIN_URL=http://localhost:3001

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters

FUNDING_GATEWAY_KEY=
FUNDING_CLIENT_API_KEY=
FUNDING_ALLOWED_ORIGINS=http://localhost:4000

FUNDING_STATE_DIR=./data
FUNDING_DEFAULT_AMOUNT_AEKO=5
FUNDING_DEFAULT_COOLDOWN_HOURS=24
FUNDING_DEFAULT_DAILY_BUDGET_AEKO=5000
FUNDING_MAX_MANUAL_GRANT_AEKO=100
FUNDING_IP_REQUESTS_PER_10_MIN=5
