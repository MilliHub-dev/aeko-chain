# Local Operations Web development.
AEKO_OPERATIONS_ROLE=admin

# Localnet is active for direct source development.
AEKO_LOCALNET_RPC_URL=http://localhost:8899
AEKO_LOCALNET_EXPLORER_API_URL=http://localhost:8088

# Optional remote networks. Leave empty for a pure localnet session.
AEKO_TESTNET_RPC_URL=
AEKO_TESTNET_EXPLORER_API_URL=
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_EXPLORER_API_URL=

AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters
