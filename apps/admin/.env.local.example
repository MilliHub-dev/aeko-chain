# Local Operations Web development. A deployed Admin instance belongs to one
# chain environment only.
AEKO_OPERATIONS_ROLE=admin
AEKO_NETWORK=localnet
AEKO_RPC_URL=http://localhost:8899
AEKO_EXPLORER_API_URL=http://localhost:8088

AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters
