AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=latest

# This Admin deployment controls exactly one chain environment.
AEKO_NETWORK=testnet
# Operations Web is a server-side control plane. Keep its upstream calls off
# public Cloudflare/WAF paths.
# Leave blank until real server-to-server origins are configured. Operations
# fails closed in production instead of falling back to localhost.
AEKO_RPC_URL=
AEKO_EXPLORER_API_URL=
AEKO_ADMIN_EXPLORER_TIMEOUT_MS=45000

AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=<long-random-settings-admin-token>
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_SESSION_SECRET=<16-plus-character-random-secret>
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
AEKO_LOG_FORMAT=json
AEKO_LOG_LEVEL=info
