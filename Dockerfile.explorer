# syntax=docker/dockerfile:1
# Backend build stage
FROM rust:1.75 AS backend-builder

WORKDIR /aeko
COPY . .

RUN cargo install sccache --locked
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/root/.cache/sccache

RUN apt-get update && apt-get install -y \
    libudev-dev \
    pkg-config \
    clang \
    libclang-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --example api_server -p aeko-explorer-backend && \
    cp target/release/examples/api_server /usr/local/bin/aeko-explorer-backend

# Frontend build stage
FROM node:18 AS frontend-builder

WORKDIR /web
COPY web/package*.json ./
RUN npm install
COPY web/ ./
RUN npm run build

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    nginx \
    && rm -rf /var/lib/apt/lists/*

COPY --from=backend-builder /usr/local/bin/aeko-explorer-backend /usr/local/bin/
COPY --from=frontend-builder /web/dist /var/www/html

COPY <<'EOF' /etc/nginx/sites-available/default
server {
    listen 3000;
    root /var/www/html;
    index index.html;
    location / {
        try_files $uri /index.html;
    }
    location /api/ {
        proxy_pass http://localhost:8088/;
    }
}
EOF

EXPOSE 8088 3000

CMD aeko-explorer-backend & nginx -g 'daemon off;'
