name: Build & Push Aeko Stack

on:
push:
branches: [ "main" ]

jobs:
build-and-push:
runs-on: ubuntu-latest
strategy:
matrix:
include:
- dockerfile: Dockerfile
image_name: aeko-node
- dockerfile: Dockerfile.explorer-backend
image_name: aeko-explorer-backend
- dockerfile: Dockerfile.explorer-ui
image_name: aeko-explorer-ui
steps:
- name: Checkout Repository
uses: actions/checkout@v4

- name: Log in to Docker Hub
uses: docker/login-action@v3
with:
username: ${{ secrets.DOCKERHUB_USERNAME }}
password: ${{ secrets.DOCKERHUB_TOKEN }}

- name: Build & Push Image
run: |
IMAGE_TAG="${{ secrets.DOCKERHUB_USERNAME }}/${{ matrix.image_name }}:latest"
docker build -f ${{ matrix.dockerfile }} -t $IMAGE_TAG .
docker push $IMAGE_TAG

trigger-dokploy:
needs: build-and-push
runs-on: ubuntu-latest
steps:
- name: Call Dokploy Webhook
run: |
curl -X POST "${{ secrets.DOKPLOY_WEBHOOK_URL }}"