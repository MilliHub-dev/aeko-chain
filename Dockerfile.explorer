# syntax=docker/dockerfile:1
#
# Aeko explorer **backend** image. Builds the `aeko-explorer-backend`
# binary (the indexer + REST API) and runs it on port 8088.
#
# The frontend lives in `Dockerfile.explorer-ui`. They are deployed as two
# separate services in `docker-compose-testnet.yml`, fronted by Coolify's
# Traefik proxy:
#   - this image            → port 8088 → https://api.aeko.online
#   - Dockerfile.explorer-ui → port 3000 → https://gossip.aeko.online
# No nginx, no port-proxying inside the container — Traefik handles HTTPS
# and routing, the way Coolify expects.

FROM rust:1.75 AS backend-builder

WORKDIR /aeko
COPY . .

RUN cargo install sccache --locked
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/root/.cache/sccache

RUN apt-get update && apt-get install -y \
    libudev-dev \
    pkg-config \
    clang \
    libclang-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/aeko/target \
    cargo build --release --bin aeko-explorer-backend -p aeko-explorer-backend && \
    mkdir -p /binaries && \
    cp target/release/aeko-explorer-backend /binaries/aeko-explorer-backend

# Runtime stage — just the binary, no web server.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libudev1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=backend-builder /binaries/aeko-explorer-backend /usr/local/bin/

EXPOSE 8088

# Retry loop: validator-1 may still be booting on first deploy. The backend
# binds to AEKO_EXPLORER_BIND (set to 0.0.0.0:8088 in compose) immediately
# and runs catch_up in a background task, so the port opens right away and
# Traefik stops returning 502.
CMD ["sh", "-c", "while true; do aeko-explorer-backend && break || (echo 'backend exited, retrying in 5s' && sleep 5); done"]
