name: Build & Push Aeko Stack

on:
push:
branches: [ "main" ]

jobs:
build-and-push:
runs-on: ubuntu-latest
steps:
- name: Checkout Code
uses: actions/checkout@v4

- name: Log in to Docker Hub
uses: docker/login-action@v3
with:
username: ${{ secrets.DOCKERHUB_USERNAME }}
password: ${{ secrets.DOCKERHUB_TOKEN }}

# 1. Build & Push Validator (matches docker-compose.yml)
- name: Build & Push Validator
run: |
docker build -f Dockerfile.validator -t surdma/aeko-validator:latest .
docker push surdma/aeko-validator:latest

# 2. Build & Push Explorer Backend
- name: Build & Push Explorer Backend
run: |
docker build -f Dockerfile.explorer-backend -t surdma/aeko-explorer-backend:latest .
docker push surdma/aeko-explorer-backend:latest

# 3. Build & Push Explorer UI
- name: Build & Push Explorer UI
run: |
docker build -f Dockerfile.explorer-ui -t surdma/aeko-explorer-ui:latest .
docker push surdma/aeko-explorer-ui:latest

# 4. Trigger Dokploy Deployment
- name: Trigger Dokploy Webhook
run: |
curl -X POST "${{ secrets.DOKPLOY_WEBHOOK_URL }}"