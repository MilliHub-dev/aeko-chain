name: Build & Push Aeko Services

on:
  push:
    branches: [ "main" ]

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      # 1. Build Validator & RPC Image
      - name: Build & Push Validator
        run: |
          docker build \
            -f Dockerfile.validator \
            -t ${{ secrets.DOCKERHUB_USERNAME }}/aeko-validator:latest .
          docker push ${{ secrets.DOCKERHUB_USERNAME }}/aeko-validator:latest

      # 2. Build Explorer Backend
      - name: Build & Push Explorer Backend
        run: |
          docker build \
            -f Dockerfile.explorer-backend \
            -t ${{ secrets.DOCKERHUB_USERNAME }}/aeko-explorer-backend:latest .
          docker push ${{ secrets.DOCKERHUB_USERNAME }}/aeko-explorer-backend:latest

      # 3. Build Explorer UI
      - name: Build & Push Explorer UI
        run: |
          docker build \
            -f Dockerfile.explorer-ui \
            -t ${{ secrets.DOCKERHUB_USERNAME }}/aeko-explorer-ui:latest .
          docker push ${{ secrets.DOCKERHUB_USERNAME }}/aeko-explorer-ui:latest

      # 4. Trigger Dokploy to pull and restart all containers
      - name: Trigger Dokploy Webhook
        run: |
          curl -X POST "${{ secrets.DOKPLOY_WEBHOOK_URL }}"