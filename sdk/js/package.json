{
  "name": "@aeko-chain/web3.js",
  "version": "0.1.1",
  "description": "AEKO Chain JavaScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "import": "./dist/connection.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "import": "./dist/transactions.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "npm run typecheck && npm run build",
    "release:publish": "npm run release:check && npm publish --access public"
  },
  "keywords": [
    "aeko",
    "blockchain",
    "web3",
    "wallet",
    "rpc"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
