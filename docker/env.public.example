# AEKO public deployment environment template.
# Copy these values into Dokploy or Coolify. Do not commit real secrets.
# In Coolify, enter the values without surrounding shell quotes.

# Required.
AEKO_PUBLIC_IP=203.0.113.10
# Dokploy/local key bind source. Coolify ignores this for storage and always
# binds the literal host path /data/aeko/keys.
AEKO_KEYS_DIR=/data/aeko/keys
EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres.example.internal:5432/aeko_explorer

# Published image selection. Prefer an immutable 12-character main commit tag.
AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=latest

# Admin app (chain.aeko.online): public testnet faucet + operator console.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters
# Server-to-server secret: Funding Gateway -> validator requestAirdrop authorization.
# Use a long random value and set the same value for the validator/admin stack.
FUNDING_GATEWAY_KEY=change-me-to-a-long-random-funding-gateway-key
# Shared with the Aeko backend (AEKO_FAUCET_API_KEY) so app users skip the per-IP throttle.
FAUCET_API_KEY=change-me
AEKO_PUBLIC_EXPLORER_URL=https://scan.aeko.online
# Both hostnames route to the admin service; the faucet host exposes only the faucet.
FAUCET_PUBLIC_HOST=chain.aeko.online
ADMIN_PUBLIC_HOST=admin.aeko.online
# Faucet policy. The per-request cap is enforced by the faucet binary itself;
# the rest are initial values for the admin console.
AEKO_FAUCET_PER_REQUEST_CAP=100
FAUCET_DEFAULT_AMOUNT_AEKO=5
FAUCET_DEFAULT_COOLDOWN_HOURS=24
FAUCET_DEFAULT_DAILY_BUDGET_AEKO=5000
FAUCET_MAX_MANUAL_GRANT_AEKO=100

# Normal redeploy defaults. Set both to 1 only for an intentional fresh-genesis
# recovery, then return both to 0 after bootstrap succeeds.
AEKO_RESET_LEDGER=0
AEKO_BOOTSTRAP_ALLOW_MISSING_STATE=0

# Validator storage/resource limits for the small-host public profile.
AEKO_LEDGER_LIMIT=8000000
AEKO_MAX_FULL_SNAPSHOTS=1
AEKO_MAX_INCREMENTAL_SNAPSHOTS=1
AEKO_ACCOUNTS_SHRINK_OPTIMIZE_TOTAL_SPACE=true
AEKO_ACCOUNTS_DB_CACHE_LIMIT_MB=512
AEKO_ACCOUNTS_INDEX_MEMORY_LIMIT_MB=512
AEKO_MIN_FREE_DISK_KB=2097152

# SocialFi bootstrap/economics.
AEKO_REWARDS_TREASURY_SEED_LAMPORTS=0
AEKO_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_STAKE_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_PLATFORM_FEE_BPS=200

# Explorer tuning.
AEKO_EXPLORER_NETWORK=testnet
AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10
AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2

# Container log retention.
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3

# Optional same-host TPU override. The Compose default is validator:8009.
# AEKO_VALIDATOR_TPU_QUIC_PEER=validator:8009
