# AEKO public deployment environment template.
# Endpoint names describe the chain network, not whether the caller happens to
# be inside or outside one Docker host.

AEKO_ENV=production

# Canonical public testnet.
AEKO_TESTNET_RPC_URL=https://rpc.aeko.online
AEKO_TESTNET_WS_URL=wss://ws.aeko.online
AEKO_TESTNET_EXPLORER_API_URL=https://api.aeko.online
AEKO_TESTNET_SOCIAL_REGISTRY_URL=https://bootstrap.aeko.online/social-registry.env
AEKO_TESTNET_PROTOCOL_REGISTRY_URL=https://bootstrap.aeko.online/protocol-registry.env
AEKO_TESTNET_FAUCET_ADDRESS=faucet.aeko.online:9900
AEKO_TESTNET_GOSSIP_HOST=gossip.aeko.online

# Mainnet is intentionally unset until a canonical AEKO mainnet is provisioned.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_MAINNET_SOCIAL_REGISTRY_URL=
AEKO_MAINNET_PROTOCOL_REGISTRY_URL=

# Local development. Individual containers may use Docker service DNS for the
# same logical localnet endpoint where loopback would refer to themselves.
AEKO_LOCALNET_RPC_URL=http://127.0.0.1:8899
AEKO_LOCALNET_WS_URL=ws://127.0.0.1:8900
AEKO_LOCALNET_EXPLORER_API_URL=http://127.0.0.1:8088
AEKO_LOCALNET_FAUCET_ADDRESS=127.0.0.1:9900

# Dokploy/local only. Coolify binds /data/aeko/keys directly.
AEKO_KEYS_DIR=/data/aeko/keys
EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres.example.com:5432/aeko_explorer

AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=latest
AEKO_REQUIRE_EXISTING_LEDGER=1
AEKO_ALLOW_CHAIN_KEY_GENERATION=0

# Optional canonical AEKO-721 demo values.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=

# Legacy Funding Gateway settings remain until that separate migration is fully
# retired. They are not blockchain endpoint selectors.
FUNDING_ALLOWED_ORIGINS=

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token
FUNDING_GATEWAY_KEY=change-me-to-a-long-random-funding-gateway-key
FUNDING_ADMIN_API_KEY=change-me-to-a-different-long-random-admin-service-key

AEKO_FAUCET_PER_REQUEST_CAP=100
FUNDING_DEFAULT_AMOUNT_AEKO=5
FUNDING_DEFAULT_COOLDOWN_HOURS=24
FUNDING_DEFAULT_DAILY_BUDGET_AEKO=5000
FUNDING_MAX_MANUAL_GRANT_AEKO=100
FUNDING_MAX_CONSOLE_AIRDROP_AEKO=25

AEKO_RESET_LEDGER=0

# AEKO Protocol is mandatory and bootstraps idempotently on every deployment.
# No protocol enable/activation lifecycle flags are required.
AEKO_TOKENOMICS_BASE_FEE_ATOMIC=250000
AEKO_REFERENCE_MINT_NAME=AEKO-20 Testnet Reference
AEKO_REFERENCE_MINT_SYMBOL=A20T
AEKO_REFERENCE_MINT_DECIMALS=9
AEKO_PUBLIC_MINT_ENABLED=true
AEKO_PUBLIC_MINT_PER_WALLET_LIMIT=1000000000000
AEKO_PUBLIC_MINT_WINDOW_EPOCHS=30
AEKO_PUBLIC_MINT_COOLDOWN_EPOCHS=1
AEKO_PUBLIC_MINT_REQUIRES_ALLOWLIST=false
AEKO_PUBLIC_MINT_ANOMALY_THRESHOLD=3
AEKO_PROTOCOL_MULTISIG_SIGNERS=
AEKO_PROTOCOL_MULTISIG_FREEZE_QUORUM=1
AEKO_PROTOCOL_MULTISIG_REVOKE_QUORUM=1
AEKO_PROTOCOL_MULTISIG_POLICY_QUORUM=1

AEKO_LEDGER_LIMIT=8000000
AEKO_MAX_FULL_SNAPSHOTS=1
AEKO_MAX_INCREMENTAL_SNAPSHOTS=1
AEKO_ACCOUNTS_SHRINK_OPTIMIZE_TOTAL_SPACE=true
AEKO_ACCOUNTS_DB_CACHE_LIMIT_MB=512
AEKO_ACCOUNTS_INDEX_MEMORY_LIMIT_MB=512
AEKO_MIN_FREE_DISK_KB=2097152

AEKO_REWARDS_TREASURY_SEED_LAMPORTS=0
AEKO_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_STAKE_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_PLATFORM_FEE_BPS=200

AEKO_EXPLORER_NETWORK=testnet
AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10
AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
