# AEKO deployment environment template.
#
# Every chain deployment has one active blockchain environment and generic
# service URLs. Mainnet, testnet and devnet are separate deployments/servers.
# Only Aeko Scan consumes the optional network-prefixed endpoint triplets below
# so users can switch between those remote deployments.

AEKO_NETWORK=testnet

# Active environment service discovery.
AEKO_RPC_URL=https://rpc.aeko.online
AEKO_WS_URL=wss://ws.aeko.online
AEKO_EXPLORER_API_URL=https://api.aeko.online
AEKO_REGISTRY_URL=https://registry.aeko.online
AEKO_FAUCET_ADDRESS=faucet.aeko.online:9900

# Scan-only alternate networks. Leave the active network's prefixed triplet
# empty; Scan gets that network from the generic URLs above.
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_WS_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_TESTNET_RPC_URL=
AEKO_TESTNET_WS_URL=
AEKO_TESTNET_EXPLORER_API_URL=
AEKO_DEVNET_RPC_URL=
AEKO_DEVNET_WS_URL=
AEKO_DEVNET_EXPLORER_API_URL=
AEKO_LOCALNET_RPC_URL=
AEKO_LOCALNET_WS_URL=
AEKO_LOCALNET_EXPLORER_API_URL=

# Validator gossip remains raw validator networking rather than HTTP. The
# hostname resolves to the advertised IP when the validator starts.
AEKO_GOSSIP_HOST=gossip.aeko.online
AEKO_VALIDATOR_TPU_QUIC_PEER=127.0.0.1:8009

# Dokploy/local only. Split Coolify binds /data/aeko/keys directly.
AEKO_KEYS_DIR=/data/aeko/keys
EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres.example:5432/aeko_explorer

AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=latest
AEKO_REQUIRE_EXISTING_LEDGER=1
AEKO_ALLOW_CHAIN_KEY_GENERATION=0
AEKO_RESET_LEDGER=0


# Local/portable host-published port overrides. Public split Coolify HTTP/WSS
# services normally use domains mapped to container ports instead.
AEKO_GOSSIP_HOST_PORT=8001
AEKO_RPC_HOST_PORT=8899
AEKO_WS_HOST_PORT=8900
AEKO_RPC_REPLICA_HOST_PORT=8898
AEKO_WS_REPLICA_HOST_PORT=8896
AEKO_EXPLORER_API_HOST_PORT=8088
AEKO_FRONTEND_HOST_PORT=4000
AEKO_OPERATIONS_WEB_HOST_PORT=3001
AEKO_BOOTSTRAP=1

# Dokploy may replace its validator-ledger named volume with a provider-managed
# volume name or absolute host path. Split Coolify uses /data/aeko/validator-ledger.
AEKO_VALIDATOR_LEDGER_VOLUME=validator-ledger

# Server-side key authorizing the constrained Scan funding/airdrop endpoint.
# Keep empty until a real secret is provisioned; never expose it to browser runtime.
AEKO_SCAN_AIRDROP_KEY=

# Recovery-only registry overrides. Normal deployments discover these values
# from the generated Social/Protocol registries. Leave empty unless performing
# an explicit operator recovery.
AEKO_SOCIAL_POSTS_STATE=
AEKO_SOCIAL_REWARDS_STATE=
AEKO_SOCIAL_STAKING_STATE=
AEKO_SOCIAL_ANTI_SPAM_STATE=
AEKO_SOCIAL_MONETIZATION_STATE=
AEKO_REWARDS_TREASURY_ACCOUNT=
AEKO_REWARD_VAULT_ACCOUNT=
AEKO_STAKE_VAULT_ACCOUNT=
AEKO_STAKE_REWARD_VAULT_ACCOUNT=
AEKO_TREASURY_ADDRESS=

# Optional canonical AEKO-721 demo values consumed by Scan.
AEKO_DEMO_RPC_URL=
AEKO_DEMO_COLLECTION=
AEKO_DEMO_TOKEN=
AEKO_DEMO_METADATA_URI=

FUNDING_ALLOWED_ORIGINS=

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-16-plus-random-characters
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=change-me-to-a-long-random-settings-admin-token

AEKO_FAUCET_PER_REQUEST_CAP=100
FUNDING_DEFAULT_AMOUNT_AEKO=5
FUNDING_DEFAULT_COOLDOWN_HOURS=24
FUNDING_DEFAULT_DAILY_BUDGET_AEKO=5000
FUNDING_MAX_MANUAL_GRANT_AEKO=100
FUNDING_MAX_CONSOLE_AIRDROP_AEKO=25

AEKO_TOKENOMICS_BASE_FEE_ATOMIC=250000
AEKO_REFERENCE_MINT_NAME=AEKO-20 Testnet Reference
AEKO_REFERENCE_MINT_SYMBOL=A20T
AEKO_REFERENCE_MINT_DECIMALS=9
AEKO_PUBLIC_MINT_ENABLED=true
AEKO_PUBLIC_MINT_PER_WALLET_LIMIT=1000000000000
AEKO_PUBLIC_MINT_WINDOW_EPOCHS=30
AEKO_PUBLIC_MINT_COOLDOWN_EPOCHS=1
AEKO_PUBLIC_MINT_REQUIRES_ALLOWLIST=false
AEKO_PUBLIC_MINT_ANOMALY_THRESHOLD=3
AEKO_PROTOCOL_MULTISIG_SIGNERS=
AEKO_PROTOCOL_MULTISIG_FREEZE_QUORUM=1
AEKO_PROTOCOL_MULTISIG_REVOKE_QUORUM=1
AEKO_PROTOCOL_MULTISIG_POLICY_QUORUM=1

AEKO_LEDGER_LIMIT=8000000
AEKO_MAX_FULL_SNAPSHOTS=1
AEKO_MAX_INCREMENTAL_SNAPSHOTS=1
AEKO_ACCOUNTS_SHRINK_OPTIMIZE_TOTAL_SPACE=true
AEKO_ACCOUNTS_DB_CACHE_LIMIT_MB=512
AEKO_ACCOUNTS_INDEX_MEMORY_LIMIT_MB=512
AEKO_MIN_FREE_DISK_KB=2097152

AEKO_REWARDS_TREASURY_SEED_LAMPORTS=0
AEKO_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_STAKE_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_PLATFORM_FEE_BPS=200

AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10
AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2
AEKO_REGISTRY_REFRESH_SECONDS=30
AEKO_REGISTRY_FETCH_TIMEOUT_SECONDS=10

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
