AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>

# This validator belongs to one chain environment.
AEKO_NETWORK=testnet
# Raw TCP endpoint: use a private address or a DNS-only hostname. Standard
# Cloudflare HTTP proxying cannot carry the Faucet protocol on port 9900.
AEKO_INTERNAL_FAUCET_ADDRESS=<private-or-dns-only-faucet-host>:9900

# Gossip is raw validator networking, but the validator accepts a resolvable
# hostname here and resolves it to an IP at startup.
AEKO_GOSSIP_HOST=gossip.aeko.online
AEKO_VALIDATOR_TPU_QUIC_PEER=127.0.0.1:8009

AEKO_REQUIRE_EXISTING_LEDGER=1
AEKO_RESET_LEDGER=0
AEKO_LEDGER_LIMIT=8000000
AEKO_MAX_FULL_SNAPSHOTS=1
AEKO_MAX_INCREMENTAL_SNAPSHOTS=1
AEKO_ACCOUNTS_SHRINK_OPTIMIZE_TOTAL_SPACE=true
AEKO_ACCOUNTS_DB_CACHE_LIMIT_MB=512
AEKO_ACCOUNTS_INDEX_MEMORY_LIMIT_MB=512
AEKO_MIN_FREE_DISK_KB=2097152
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3

# Required for approval-gated requestGrant. Use the exact same secret on the
# corresponding Explorer API deployment. requestAirdrop is a separate instant
# developer path and does not use this credential.
AEKO_FUNDING_AUTHORIZATION_KEY=<32-plus-character-server-secret>
