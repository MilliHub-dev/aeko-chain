AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>

# This validator belongs to one chain environment.
AEKO_NETWORK=testnet
# Raw TCP endpoint for the independently deployed Faucet. Use a private/VPC/
# overlay address or DNS-only hostname reachable from this Validator container.
# Standard Cloudflare HTTP proxying cannot carry the Faucet protocol on 9900.
# Never use localhost, 127.0.0.1, ::1, or 0.0.0.0 for a split deployment.
# Leave blank until the real reachable Faucet host:port is configured.
AEKO_FAUCET_ADDRESS=

# Required for split Validator networking. Use this network's direct/DNS-only
# gossip hostname or public IP, with no URL scheme or port. The Validator
# resolves it at startup. Testnet uses gossip.aeko.online; mainnet/devnet must
# use their own network-specific hostname.
AEKO_GOSSIP_HOST=
AEKO_VALIDATOR_TPU_QUIC_PEER=127.0.0.1:8009

AEKO_REQUIRE_EXISTING_LEDGER=1
AEKO_RESET_LEDGER=0
AEKO_LEDGER_LIMIT=8000000
AEKO_MAX_FULL_SNAPSHOTS=1
AEKO_MAX_INCREMENTAL_SNAPSHOTS=1
AEKO_ACCOUNTS_SHRINK_OPTIMIZE_TOTAL_SPACE=true
AEKO_ACCOUNTS_DB_CACHE_LIMIT_MB=512
AEKO_ACCOUNTS_INDEX_MEMORY_LIMIT_MB=512
AEKO_MIN_FREE_DISK_KB=2097152
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3

# Required for protected requestFunding settlement. Use the exact same secret
# on the corresponding Explorer API deployment. requestAirdrop is a separate
# test-environment utility and is rejected on Mainnet.
AEKO_FUNDING_AUTHORIZATION_KEY=<32-plus-character-server-secret>
