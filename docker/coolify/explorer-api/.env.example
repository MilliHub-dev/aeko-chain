AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>
AEKO_INTERNAL_RPC_URL=http://10.0.0.10:8899
EXPLORER_DATABASE_URL=postgres://aeko:change-me@postgres.example.internal:5432/aeko_explorer
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=<long-random-settings-admin-token>
AEKO_EXPLORER_NETWORK=testnet
AEKO_EXPLORER_START_SLOT=0
AEKO_EXPLORER_MAX_BATCH_SIZE=256
AEKO_EXPLORER_PERSIST_SOCIALFI_VIEWS=true
AEKO_EXPLORER_ASSET_REFRESH_SLOTS=64
AEKO_EXPLORER_SOCIAL_REFRESH_SLOTS=16
AEKO_EXPLORER_MAX_READY_LAG_SLOTS=128
AEKO_EXPLORER_DB_MAX_CONNECTIONS=16
AEKO_EXPLORER_DB_MIN_CONNECTIONS=1
AEKO_EXPLORER_DB_ACQUIRE_TIMEOUT_SECS=10
AEKO_EXPLORER_RPC_TIMEOUT_SECS=15
AEKO_EXPLORER_REQUEST_TIMEOUT_SECS=30
AEKO_EXPLORER_MAX_BODY_BYTES=1048576
AEKO_EXPLORER_SYNC_INTERVAL_SECS=2
AEKO_RESET_LEDGER=0
AEKO_SCAN_AIRDROP_KEY=
# Safe host-port default. Change only to a VPN/private NIC for cross-server use.
AEKO_EXPLORER_API_BIND_IP=127.0.0.1
AEKO_EXPLORER_API_HOST_PORT=8088
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3

# Leave the registry values below empty when this resource mounts the canonical
# /data/aeko/social-state and /data/aeko/protocol-state from the bootstrap host.
# For a different Explorer host, populate the COMPLETE canonical registry set.
AEKO_REGISTRY_SCHEMA_VERSION=
AEKO_CHAIN_GENESIS_HASH=
AEKO_SOCIAL_POSTS_STATE=
AEKO_SOCIAL_REWARDS_STATE=
AEKO_SOCIAL_STAKING_STATE=
AEKO_SOCIAL_ANTI_SPAM_STATE=
AEKO_SOCIAL_MONETIZATION_STATE=
AEKO_REWARDS_TREASURY_ACCOUNT=
AEKO_REWARD_VAULT_ACCOUNT=
AEKO_STAKE_VAULT_ACCOUNT=
AEKO_STAKE_REWARD_VAULT_ACCOUNT=
AEKO_TREASURY_ADDRESS=
AEKO_PLATFORM_FEE_BPS=
AEKO_PROTOCOL_AUTHORITY=
AEKO_TOKEN_PROGRAMS_FEATURE=
AEKO_TOKEN_PROGRAMS_FEATURE_ACTIVATED_AT=
AEKO_PERMISSION_LAYER_FEATURE=
AEKO_PERMISSION_LAYER_FEATURE_ACTIVATED_AT=
AEKO_TOKENOMICS_PROGRAM_ID=
AEKO_TOKEN_20_PROGRAM_ID=
AEKO_PUBLIC_MINT_PROGRAM_ID=
AEKO_TOKEN_721_PROGRAM_ID=
AEKO_NFT_MARKETPLACE_PROGRAM_ID=
AEKO_WALLET_PERMISSIONS_PROGRAM_ID=
AEKO_PERMISSION_REGISTRY_PROGRAM_ID=
AEKO_REVOCATION_REGISTRY_PROGRAM_ID=
AEKO_SUBNET_REGISTRY_PROGRAM_ID=
AEKO_EMERGENCY_MULTISIG_PROGRAM_ID=
AEKO_FINALITY_ORACLE_PROGRAM_ID=
AEKO_TOKENOMICS_STATE=
AEKO_AEKO20_REFERENCE_MINT=
AEKO_PUBLIC_MINT_STATE=
AEKO_PERMISSION_REGISTRY_STATE=
AEKO_REVOCATION_REGISTRY_STATE=
AEKO_SUBNET_REGISTRY_STATE=
AEKO_EMERGENCY_MULTISIG_STATE=
AEKO_FINALITY_ORACLE_STATE=
AEKO_TOKENOMICS_TREASURY_ACCOUNT=
AEKO_VALIDATOR_REWARDS_ACCOUNT=
AEKO_COMMUNITY_REWARDS_ACCOUNT=
