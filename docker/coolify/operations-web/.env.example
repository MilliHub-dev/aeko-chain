AEKO_IMAGE_REPOSITORY=surdma
# Use latest with the split post-promotion webhook workflow.
# Pin an immutable SHA instead when deployment also updates this value explicitly.
AEKO_IMAGE_TAG=latest
AEKO_TESTNET_RPC_URL=https://rpc.aeko.online
AEKO_TESTNET_EXPLORER_API_URL=https://api.aeko.online
AEKO_MAINNET_RPC_URL=
AEKO_MAINNET_EXPLORER_API_URL=
AEKO_LOCALNET_RPC_URL=
AEKO_LOCALNET_EXPLORER_API_URL=
AEKO_EXPLORER_SETTINGS_ADMIN_TOKEN=<long-random-settings-admin-token>
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_SESSION_SECRET=<16-plus-character-random-secret>
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
