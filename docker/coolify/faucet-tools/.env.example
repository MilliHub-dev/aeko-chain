AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>

AEKO_FAUCET_PER_REQUEST_CAP=100

# Canonical testnet consumer address:
#   faucet.aeko.online:9900
#
# Faucet is raw TCP, so DNS is only the stable address. If a TCP proxy/VPN
# terminates on this host, loopback may remain correct. For direct cross-host
# traffic, bind to the required host interface and restrict TCP 9900 so only
# Validator infrastructure can reach it.
AEKO_FAUCET_BIND_IP=127.0.0.1
AEKO_FAUCET_HOST_PORT=9900

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
