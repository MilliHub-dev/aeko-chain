AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>
AEKO_NETWORK=testnet

# Faucet is raw TCP and independently deployable from Validator/RPC nodes.
# Required: bind TCP 9900 to a host interface those remote consumers can reach.
# Prefer a private/VPC/WireGuard/overlay interface. Never use 127.0.0.1,
# localhost, or ::1 for a split deployment. Use 0.0.0.0 only when the
# host/cloud firewall restricts TCP 9900 to trusted Validator/RPC source IPs.
AEKO_FAUCET_BIND_ADDRESS=
AEKO_FAUCET_HOST_PORT=9900
AEKO_FAUCET_PER_REQUEST_CAP=100

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
