AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>

AEKO_FAUCET_PER_REQUEST_CAP=100

AEKO_TESTNET_FAUCET_ADDRESS=faucet.aeko.online:9900
AEKO_TESTNET_FAUCET_PORT=9900

# faucet.aeko.online must resolve to this Faucet host. TCP 9900 is not HTTP;
# restrict it at the host/cloud firewall to the Validator source address.

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
