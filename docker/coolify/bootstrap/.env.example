AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>

# Testnet RPC domain. Override only when this deployment targets another testnet RPC origin.
AEKO_TESTNET_RPC_URL=https://rpc.aeko.online

# Established-chain defaults. Enable key generation only for intentional first boot.
AEKO_ALLOW_CHAIN_KEY_GENERATION=0
AEKO_RESET_LEDGER=0

AEKO_REWARDS_TREASURY_SEED_LAMPORTS=0
AEKO_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_STAKE_REWARD_VAULT_SEED_LAMPORTS=0
AEKO_PLATFORM_FEE_BPS=200

AEKO_TOKENOMICS_BASE_FEE_ATOMIC=250000
AEKO_REFERENCE_MINT_NAME=AEKO-20 Testnet Reference
AEKO_REFERENCE_MINT_SYMBOL=A20T
AEKO_REFERENCE_MINT_DECIMALS=9
AEKO_PUBLIC_MINT_ENABLED=true
AEKO_PUBLIC_MINT_PER_WALLET_LIMIT=1000000000000
AEKO_PUBLIC_MINT_WINDOW_EPOCHS=30
AEKO_PUBLIC_MINT_COOLDOWN_EPOCHS=1
AEKO_PUBLIC_MINT_REQUIRES_ALLOWLIST=false
AEKO_PUBLIC_MINT_ANOMALY_THRESHOLD=3
AEKO_PROTOCOL_MULTISIG_SIGNERS=
AEKO_PROTOCOL_MULTISIG_FREEZE_QUORUM=1
AEKO_PROTOCOL_MULTISIG_REVOKE_QUORUM=1
AEKO_PROTOCOL_MULTISIG_POLICY_QUORUM=1

# Route registry.aeko.online to bootstrap-registry:8080 in Coolify.
# Only social.env and protocol.env are served. Private *.json keypairs are not.
AEKO_TESTNET_REGISTRY_URL=https://registry.aeko.online/testnet

AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
