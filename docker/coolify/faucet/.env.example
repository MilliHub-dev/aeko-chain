AEKO_IMAGE_REPOSITORY=surdma
AEKO_IMAGE_TAG=<published-12-character-main-sha>
AEKO_FAUCET_PER_REQUEST_CAP=100
# Leave loopback for same-server/predefined-network deployments.
# Set to a VPN/private NIC address only when Validator runs on another server.
AEKO_FAUCET_BIND_IP=127.0.0.1
AEKO_FAUCET_HOST_PORT=9900
AEKO_LOG_MAX_SIZE=10m
AEKO_LOG_MAX_FILES=3
