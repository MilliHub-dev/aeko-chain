# syntax=docker/dockerfile:1
# Build stage
FROM rust:1.75 AS builder

WORKDIR /aeko
COPY . .

# Install sccache for faster subsequent builds
RUN cargo install sccache --locked
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/root/.cache/sccache

# Install build dependencies
RUN apt-get update && apt-get install -y \
    libudev-dev \
    pkg-config \
    clang \
    libclang-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Cache mounts persist between builds on the same host, keeping sccache and
# cargo registry warm so subsequent builds don't start from scratch.
RUN --mount=type=cache,target=/root/.cache/sccache \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/aeko/target \
    cargo build --release \
        --bin aeko-validator \
        --bin aeko-keygen \
        --bin aeko-genesis \
        --bin aeko \
        --bin aeko-faucet && \
    mkdir /binaries && \
    cp target/release/aeko-validator \
       target/release/aeko-keygen \
       target/release/aeko-genesis \
       target/release/aeko \
       target/release/aeko-faucet \
       /binaries/

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libudev1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /binaries/aeko-validator /usr/local/bin/
COPY --from=builder /binaries/aeko-keygen /usr/local/bin/
COPY --from=builder /binaries/aeko-genesis /usr/local/bin/
COPY --from=builder /binaries/aeko /usr/local/bin/
COPY --from=builder /binaries/aeko-faucet /usr/local/bin/

EXPOSE 8001/udp 8001/tcp 8899

ENTRYPOINT ["aeko-validator"]
