# syntax=docker/dockerfile:1
# Build stage
FROM rust:1.75 AS builder

# Install sccache from pre-built binary (before COPY to keep this layer cached)
RUN curl -fsSL https://github.com/mozilla/sccache/releases/download/v0.8.2/sccache-v0.8.2-x86_64-unknown-linux-musl.tar.gz \
    | tar xzf - --strip-components=1 -C /usr/local/cargo/bin sccache-v0.8.2-x86_64-unknown-linux-musl/sccache
ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/root/.cache/sccache

# Install build dependencies before COPY to keep this layer cached
RUN apt-get update && apt-get install -y \
    libudev-dev \
    pkg-config \
    clang \
    libclang-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /aeko
COPY . .

# Unique cache IDs prevent lock conflicts when multiple images build in parallel.
RUN --mount=type=cache,id=validator-sccache,target=/root/.cache/sccache \
    --mount=type=cache,id=validator-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=validator-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=validator-target,target=/aeko/target \
    cargo build --release \
        --bin aeko-validator \
        --bin aeko-keygen \
        --bin aeko-genesis \
        --bin aeko \
        --bin aeko-faucet \
        --bin aeko-social-bootstrap && \
    mkdir /binaries && \
    cp target/release/aeko-validator \
       target/release/aeko-keygen \
       target/release/aeko-genesis \
       target/release/aeko \
       target/release/aeko-faucet \
       target/release/aeko-social-bootstrap \
       /binaries/

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libudev1 \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /binaries/aeko-validator /usr/local/bin/
COPY --from=builder /binaries/aeko-keygen /usr/local/bin/
COPY --from=builder /binaries/aeko-genesis /usr/local/bin/
COPY --from=builder /binaries/aeko /usr/local/bin/
COPY --from=builder /binaries/aeko-faucet /usr/local/bin/
COPY --from=builder /binaries/aeko-social-bootstrap /usr/local/bin/

COPY validator-entrypoint.sh /usr/local/bin/validator-entrypoint.sh
RUN chmod +x /usr/local/bin/validator-entrypoint.sh

EXPOSE 8001/udp 8001/tcp 8899

ENTRYPOINT ["/usr/local/bin/validator-entrypoint.sh"]
